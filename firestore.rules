rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    // Rules for User Metadata
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Allow users to create their own basic record on first login
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Only admins can update other users or change roles
      allow update, delete: if isAdmin();
    }

    // Rules for Settings
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      // Allow authenticated users to update global settings (institutional data) for now
      allow write: if isAuthenticated();
    }

    // Rules for Generated Documents (terms, inventory, etc)
    match /generated_terms/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    match /inventory/{docId} {
      allow read, write: if isAuthenticated();
    }

    // Default deny
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
